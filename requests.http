@baseUrl = http://localhost:5289
@token = COLE_O_TOKEN_AQUI
@orderId = COLE_O_ORDER_ID_AQUI

### 1 - Login válido
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "dev@martech.com",
  "password": "Senha@123"
}

### 2 - Login inválido - esperado 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "dev@martech.com",
  "password": "senha-incorreta"
}

### 3 - Criar pedido sem token - esperado 401
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "items": [
    {
      "productName": "Notebook",
      "quantity": 2,
      "unitPrice": 5000
    }
  ]
}

### 4 - Criar pedido válido - esperado 201
POST {{baseUrl}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "items": [
    {
      "productName": "Notebook",
      "quantity": 2,
      "unitPrice": 5000
    },
    {
      "productName": "Mouse",
      "quantity": 1,
      "unitPrice": 150
    }
  ]
}

### 5 - Listar pedidos - esperado 200
GET {{baseUrl}}/api/orders?page=1&pageSize=10
Authorization: Bearer {{token}}

### 6 - Buscar pedido por ID - esperado 200
GET {{baseUrl}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}

### 7 - Cancelar pedido Pending - esperado 204
PATCH {{baseUrl}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}

### 8 - Buscar pedido cancelado - esperado 200 / Status Cancelled
GET {{baseUrl}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}

### 9 - Cancelar novamente - esperado 409
PATCH {{baseUrl}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}

### 10 - Pedido inválido: Quantity = 0 - esperado 400
POST {{baseUrl}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "items": [
    {
      "productName": "Notebook",
      "quantity": 0,
      "unitPrice": 5000
    }
  ]
}

### 11 - Pedido inválido: items vazio - esperado 400
POST {{baseUrl}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "items": []
}

### 12 - Paginação inválida - esperado 400
GET {{baseUrl}}/api/orders?page=0&pageSize=10
Authorization: Bearer {{token}}

### 13 - Pedido inexistente - esperado 404
GET {{baseUrl}}/api/orders/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### 14 - OpenAPI - esperado 200
GET {{baseUrl}}/openapi/v1.json
